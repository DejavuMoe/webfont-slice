{
  "name": "webfont-slice",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "description": "浏览器本地运行的网页字体分包工具：中日韩、西文与代码等宽字体",
  "license": "MIT",
  "homepage": "https://github.com/DejavuMoe/webfont-slice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DejavuMoe/webfont-slice.git"
  },
  "bugs": {
    "url": "https://github.com/DejavuMoe/webfont-slice/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preinstall": "node tools/ensure-pnpm.mjs",
    "postinstall": "node tools/prepare-wawoff2.mjs",
    "prepare:wawoff2": "node tools/prepare-wawoff2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:only": "playwright test",
    "lint": "eslint . --max-warnings=0 && pnpm run core:typecheck && pnpm run architecture:verify",
    "core:typecheck": "tsc -p tsconfig.core.json",
    "architecture:verify": "node tools/verify-architecture-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "charsets:build": "node tools/build-charsets/index.mjs",
    "charsets:verify": "node tools/verify-charsets.mjs",
    "frequency:build": "node tools/build-frequency.mjs",
    "frequency:verify": "node tools/build-frequency.mjs --check",
    "benchmark:planner": "node tools/benchmark-planner.mjs",
    "icons:build": "node tools/build-app-icons.mjs",
    "icons:verify": "node tools/build-app-icons.mjs --check",
    "unicode-blocks:build": "node tools/build-unicode-blocks.mjs",
    "unicode-blocks:verify": "node tools/build-unicode-blocks.mjs --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run charsets:verify && pnpm run frequency:verify && pnpm run unicode-blocks:verify && pnpm run icons:verify && pnpm run build"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "0.8.3",
    "hb-subset-wasm": "0.4.0",
    "lucide-react": "^1.48.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wawoff2": "2.0.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.0",
    "subtlex-ch-chr": "0.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
